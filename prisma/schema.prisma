generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  displayName      String
  avatarUrl        String?
  avatarStorageKey String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model Attachment {
  id          String   @id @default(cuid())
  fileName    String
  contentType String
  sizeBytes   Int
  storageKey  String   @unique
  postId      String?
  createdAt   DateTime @default(now())

  @@index([postId])
  @@map("attachments")
}
